generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(CUSTOMER)
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  idempotencyRecords IdempotencyRecord[]
  payments  Payment[]
  loyaltyTransactions LoyaltyTransaction[]
  paymentIntents PaymentIntent[]
  redemptions Redemption[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  price       Int
  stock       Int         @default(0)
  category    String      @default("Khác")
  imageUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  recipe      RecipeItem[]
}

model Topping {
  id                Int                @id @default(autoincrement())
  name              String
  price             Int
  orderItemToppings OrderItemTopping[]
  recipe            ToppingRecipeItem[]
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  status    OrderStatus @default(PENDING)
  subtotal  Int
  discount  Int         @default(0)
  promoCode String?
  total     Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]
  idempotencyRecord IdempotencyRecord?
  payments  Payment[]
  loyaltyTransactions LoyaltyTransaction[]
  paymentIntents PaymentIntent[]
  ingredientUses OrderIngredientUse[]

  @@index([userId])
}

model OrderItem {
  id        Int                @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Int
  size      String
  // true: kho được trừ theo công thức nguyên liệu; false: trừ Product.stock (sản phẩm chưa có công thức).
  usesRecipe Boolean           @default(false)
  order     Order              @relation(fields: [orderId], references: [id])
  product   Product            @relation(fields: [productId], references: [id])
  toppings  OrderItemTopping[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemTopping {
  orderItemId Int
  toppingId   Int
  quantity    Int
  price       Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  topping     Topping   @relation(fields: [toppingId], references: [id])

  @@id([orderItemId, toppingId])
}

model Promotion {
  id         Int           @id @default(autoincrement())
  code       String        @unique
  type       PromotionType
  value      Int
  minOrder   Int           @default(0)
  expiresAt  DateTime?
  usageCount Int           @default(0)
}

model LoyaltyTransaction {
  id        Int         @id @default(autoincrement())
  userId    Int
  orderId   Int
  type      LoyaltyType
  points    Int
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id])
  order     Order       @relation(fields: [orderId], references: [id])

  @@unique([orderId, type])
  @@index([userId])
}

enum LoyaltyType {
  EARN
  REVERSAL
}

enum Role {
  CUSTOMER
  STAFF
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  CANCELLED
  PREPARING
  READY
  COMPLETED
}

enum PaymentMethod {
  WALLET
  CARD
  BANK
  MOMO
  VNPAY
}

enum PaymentProvider {
  BANK
  MOMO
  VNPAY
}

enum IntentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum PaymentStatus {
  SUCCESS
  FAILED
}

enum PromotionType {
  PERCENT
  FIXED
}
model IdempotencyRecord {
  id          Int      @id @default(autoincrement())
  userId      Int
  key         String
  requestHash String
  orderId     Int      @unique
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@unique([userId, key])
  @@index([createdAt])
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int
  userId         Int
  method         PaymentMethod
  status         PaymentStatus
  amount         Int
  idempotencyKey String
  requestHash    String
  providerRef    String?
  createdAt      DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([orderId])
}

// ---- Nguyên liệu và công thức đồ uống ----

model Ingredient {
  id      Int          @id @default(autoincrement())
  name    String       @unique
  unit    String
  stock   Int          @default(0)
  recipes RecipeItem[]
  toppingRecipes ToppingRecipeItem[]
  uses    OrderIngredientUse[]
}

model RecipeItem {
  id           Int        @id @default(autoincrement())
  productId    Int
  ingredientId Int
  quantity     Int // lượng nguyên liệu cho 1 ly
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@index([ingredientId])
}

// Nguyên liệu mỗi phần topping (không đổi theo size ly).
model ToppingRecipeItem {
  id           Int        @id @default(autoincrement())
  toppingId    Int
  ingredientId Int
  quantity     Int
  topping      Topping    @relation(fields: [toppingId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([toppingId, ingredientId])
  @@index([ingredientId])
}

// Lượng nguyên liệu đã trừ cho một đơn, để hoàn lại chính xác khi hủy.
model OrderIngredientUse {
  orderId      Int
  ingredientId Int
  quantity     Int
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([orderId, ingredientId])
}

// ---- Tài khoản thanh toán TEST và phiên thanh toán QR ----

model PaymentAccount {
  id         Int             @id @default(autoincrement())
  provider   PaymentProvider
  identifier String // số tài khoản / số điện thoại ví / số thẻ test
  holderName String
  pinHash    String
  balance    Int
  intents    PaymentIntent[]

  @@unique([provider, identifier])
}

model PaymentIntent {
  id          Int             @id @default(autoincrement())
  token       String          @unique
  orderId     Int
  userId      Int
  provider    PaymentProvider
  amount      Int
  status      IntentStatus    @default(PENDING)
  mode        String // SIMULATED | SANDBOX
  expiresAt   DateTime
  providerRef String?
  accountId   Int?
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  order       Order           @relation(fields: [orderId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
  account     PaymentAccount? @relation(fields: [accountId], references: [id])

  @@index([orderId])
}

// ---- Quà đổi điểm ----

model Reward {
  id          Int          @id @default(autoincrement())
  name        String
  description String       @default("")
  pointsCost  Int
  active      Boolean      @default(true)
  redemptions Redemption[]
}

model Redemption {
  id          Int      @id @default(autoincrement())
  userId      Int
  rewardId    Int
  pointsSpent Int
  code        String   @unique
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  reward      Reward   @relation(fields: [rewardId], references: [id])

  @@index([userId])
}
