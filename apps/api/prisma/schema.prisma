generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(CUSTOMER)
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  idempotencyRecords IdempotencyRecord[]
  payments  Payment[]
  loyaltyTransactions LoyaltyTransaction[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  price       Int
  stock       Int         @default(0)
  category    String      @default("Khác")
  imageUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Topping {
  id                Int                @id @default(autoincrement())
  name              String
  price             Int
  orderItemToppings OrderItemTopping[]
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  status    OrderStatus @default(PENDING)
  subtotal  Int
  discount  Int         @default(0)
  promoCode String?
  total     Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]
  idempotencyRecord IdempotencyRecord?
  payments  Payment[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([userId])
}

model OrderItem {
  id        Int                @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Int
  size      String
  order     Order              @relation(fields: [orderId], references: [id])
  product   Product            @relation(fields: [productId], references: [id])
  toppings  OrderItemTopping[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemTopping {
  orderItemId Int
  toppingId   Int
  quantity    Int
  price       Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  topping     Topping   @relation(fields: [toppingId], references: [id])

  @@id([orderItemId, toppingId])
}

model Promotion {
  id         Int           @id @default(autoincrement())
  code       String        @unique
  type       PromotionType
  value      Int
  minOrder   Int           @default(0)
  expiresAt  DateTime?
  usageCount Int           @default(0)
}

model LoyaltyTransaction {
  id        Int         @id @default(autoincrement())
  userId    Int
  orderId   Int
  type      LoyaltyType
  points    Int
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id])
  order     Order       @relation(fields: [orderId], references: [id])

  @@unique([orderId, type])
  @@index([userId])
}

enum LoyaltyType {
  EARN
  REVERSAL
}

enum Role {
  CUSTOMER
  STAFF
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  CANCELLED
  PREPARING
  READY
  COMPLETED
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PaymentStatus {
  SUCCESS
  FAILED
}

enum PromotionType {
  PERCENT
  FIXED
}
model IdempotencyRecord {
  id          Int      @id @default(autoincrement())
  userId      Int
  key         String
  requestHash String
  orderId     Int      @unique
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@unique([userId, key])
  @@index([createdAt])
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int
  userId         Int
  method         PaymentMethod
  status         PaymentStatus
  amount         Int
  idempotencyKey String
  requestHash    String
  createdAt      DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([orderId])
}
