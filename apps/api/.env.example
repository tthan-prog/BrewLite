# Sao chép file này thành .env rồi sửa giá trị. KHÔNG đưa file .env lên Git.
PORT=3001
# Địa chỉ frontend được phép gọi API (CORS); nhiều địa chỉ cách nhau bằng dấu phẩy
FRONTEND_ORIGIN=http://localhost:3000

# Các biến dưới đây dùng từ Task 2 trở đi (CSDL, JWT) - chưa dùng trong khung dự án
DATABASE_URL=postgresql://brewlite:change_me@localhost:5432/brewlite
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# --- Thanh toán QR (xem docs/payment-qr-ingredients.md) ---
# Địa chỉ web mà ĐIỆN THOẠI mở được khi quét QR. Để localhost (hoặc trống) khi chạy local: API tự thay bằng
# IP mạng nội bộ của máy (tắt: PUBLIC_WEB_AUTO=false). Khi triển khai, đặt URL công khai.
PUBLIC_WEB_URL=http://localhost:3000
# Địa chỉ API mà cổng thanh toán gọi lại (return/IPN); phải là URL công khai khi dùng sandbox thật
PUBLIC_API_URL=http://localhost:3001
# Thời hạn mã QR (phút)
PAYMENT_QR_TTL_MINUTES=10
# Để trống = chế độ mô phỏng. Điền khóa SANDBOX do VNPay/MoMo cấp để bật chế độ sandbox (KHÔNG commit khóa).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
