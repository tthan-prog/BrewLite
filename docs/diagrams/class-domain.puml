@startuml class-domain
title Class diagram - Đặt hàng và điểm thưởng (khớp schema.prisma)
skinparam shadowing false
skinparam classAttributeIconSize 0
class User {
  - id : int
  - email : string
  - name : string
  - password : string
  - role : Role
  - points : int
  + register() : User
  + login() : string
  + redeem(rewardId : int) : Redemption
}
class Product {
  - id : int
  - name : string
  - price : int
  - stock : int
  - category : string
  - imageUrl : string
  + maxCups() : int
}
class Topping {
  - id : int
  - name : string
  - price : int
}
class Order {
  - id : int
  - status : OrderStatus
  - subtotal : int
  - discount : int
  - promoCode : string
  - total : int
  - createdAt : datetime
  + canTransition(to : OrderStatus) : boolean
  + assertTransition(to : OrderStatus) : void
  + pointsForTotal() : int
}
class OrderItem {
  - id : int
  - quantity : int
  - size : string
  - unitPrice : int
  - usesRecipe : boolean
  - sugar : int
  - ice : int
}
class OrderItemTopping {
  - quantity : int
  - price : int
}
class Promotion {
  - id : int
  - code : string
  - type : PromotionType
  - value : int
  - minOrder : int
  - expiresAt : datetime
  - usageCount : int
  + evaluate(subtotal : int) : int
}
class LoyaltyTransaction {
  - id : int
  - type : LoyaltyType
  - points : int
  - createdAt : datetime
}
class IdempotencyRecord {
  - id : int
  - key : string
  - requestHash : string
  - createdAt : datetime
}

User "1" -- "0..*" Order : đặt >
Order "1" *-- "1..*" OrderItem : gồm >
OrderItem "0..*" -- "1" Product : tham chiếu >
(OrderItem, Topping) .. OrderItemTopping
OrderItem "0..*" -- "0..*" Topping : kèm >
Order "0..*" -- "0..1" Promotion : áp dụng theo promoCode >
User "1" -- "0..*" LoyaltyTransaction : có >
Order "1" -- "0..2" LoyaltyTransaction : sinh ra >
Order "1" -- "0..1" IdempotencyRecord : chống tạo trùng >
User "1" -- "0..*" IdempotencyRecord : sở hữu >

note bottom of Order
  status : OrderStatus = PENDING | PAID | PAYMENT_FAILED |
  CANCELLED | PREPARING | READY | COMPLETED.
  Thao tác ánh xạ tới order-state.ts (canTransition,
  assertTransition, pointsForTotal).
end note
note bottom of LoyaltyTransaction
  type : LoyaltyType = EARN (đơn PAID) | REVERSAL (hủy đơn đã PAID);
  points âm với REVERSAL. User.points là số dư hiện tại.
end note
note bottom of Promotion
  type : PromotionType = PERCENT | FIXED.
  evaluate ánh xạ tới evaluatePromotion (pricing.ts).
end note
@enduml
