@startuml usecase-checkout
title Use case diagram - UC-01 Đặt và thanh toán đơn hàng
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Khách hàng" as Customer
actor "Nhân viên" as Staff
actor "Dịch vụ thanh toán\n(mô phỏng)" as PAY

rectangle "BrewLite" {
  usecase "Đăng nhập" as UC_Auth
  usecase "Đặt đơn" as UC_Order
  usecase "Áp mã khuyến mãi" as UC_Promo
  usecase "Thanh toán đơn" as UC_Pay
  usecase "Thử lại thanh toán" as UC_Retry
  usecase "Tích điểm thưởng" as UC_Earn
  usecase "Xem đơn đã đặt" as UC_Track
  usecase "Hủy đơn" as UC_Cancel
}

Customer -- UC_Order
Customer -- UC_Pay
Customer -- UC_Track
Staff -- UC_Cancel
UC_Pay -- PAY

UC_Order ..> UC_Auth : <<include>>
UC_Pay ..> UC_Auth : <<include>>
UC_Promo ..> UC_Order : <<extend>>\n{khách nhập mã}
UC_Retry ..> UC_Pay : <<extend>>\n{thanh toán thất bại}
UC_Earn ..> UC_Pay : <<extend>>\n{thanh toán thành công}
@enduml
