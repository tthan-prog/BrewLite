@startuml activity-order-flow
title Activity diagram - Đặt đơn hàng (phần 1/2)
skinparam shadowing false

|Khách hàng|
start
:Xem menu;
:Chọn đồ uống, size, topping;
:Thêm vào giỏ hàng;

repeat
  |Khách hàng|
  :Bấm "Đặt đơn";

  |Hệ thống|
  if (Đã đăng nhập?) then (Chưa)
    |Khách hàng|
    :Đăng nhập hoặc đăng ký;
    |Hệ thống|
    :Xác thực tài khoản;
  else (Rồi)
  endif
  :Kiểm tra dữ liệu giỏ hàng;
  :Kiểm tra đủ nguyên liệu\ncho cả đơn;

  if (Đủ nguyên liệu?) then (Có)
    :Tạo đơn ở trạng thái\nPENDING;
  else (Không)
    :Từ chối, không tạo đơn;
    |Khách hàng|
    :Nhận thông báo\nthiếu nguyên liệu;
    :Chỉnh sửa giỏ hàng;
  endif
repeat while (Đã tạo đơn?) is (Chưa) not (Rồi)

|Khách hàng|
:Chuyển sang\nthanh toán (phần 2);
stop
@enduml
