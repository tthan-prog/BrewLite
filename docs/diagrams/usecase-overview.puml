@startuml usecase-overview
title Use case diagram - BrewLite (tổng quan)
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Khách hàng" as Customer
actor "Nhân viên" as Staff
actor "Dịch vụ thanh toán\n(mô phỏng)" as PAY

rectangle "BrewLite" {
  usecase "Xem menu" as UC_Menu
  usecase "Xem chi tiết sản phẩm" as UC_Detail
  usecase "Quản lý giỏ hàng" as UC_Cart
  usecase "Đăng ký tài khoản" as UC_Register
  usecase "Đăng nhập" as UC_Login
  usecase "Đặt đơn" as UC_Order
  usecase "Thanh toán đơn" as UC_Pay
  usecase "Xem lịch sử đơn" as UC_History
  usecase "Đổi quà bằng điểm" as UC_Redeem
  usecase "Cập nhật trạng thái đơn" as UC_Status
  usecase "Hủy đơn" as UC_Cancel
  usecase "Quản lý nguyên liệu" as UC_Stock
}

Customer -- UC_Menu
Customer -- UC_Detail
Customer -- UC_Cart
Customer -- UC_Register
Customer -- UC_Login
Customer -- UC_Order
Customer -- UC_Pay
Customer -- UC_History
Customer -- UC_Redeem

Staff -- UC_Status
Staff -- UC_Cancel
Staff -- UC_Stock

UC_Pay -- PAY

UC_Order ..> UC_Login : <<include>>
UC_Pay ..> UC_Login : <<include>>
UC_Redeem ..> UC_Login : <<include>>

note bottom of UC_Pay
  UC-01 gồm "Đặt đơn" và "Thanh toán đơn";
  chi tiết ở sơ đồ usecase-checkout.
end note
@enduml
