erDiagram
    USER ||--o{ ORDER : places
    USER ||--o{ PAYMENT : makes
    USER ||--o{ LOYALTY_TRANSACTION : earns_or_reverses
    USER ||--o{ IDEMPOTENCY_RECORD : creates

    ORDER ||--|{ ORDER_ITEM : contains
    ORDER ||--o{ PAYMENT : has
    ORDER ||--o{ LOYALTY_TRANSACTION : records
    ORDER ||--o| IDEMPOTENCY_RECORD : protects

    PRODUCT ||--o{ ORDER_ITEM : included_in

    ORDER_ITEM ||--o{ ORDER_ITEM_TOPPING : has
    TOPPING ||--o{ ORDER_ITEM_TOPPING : selected_in

    USER {
        int id PK
        string email UK
        string name
        string password
        string role
        int points
        datetime createdAt
        datetime updatedAt
    }

    PRODUCT {
        int id PK
        string name
        string description
        int price
        int stock
        string category
        string imageUrl
        datetime createdAt
        datetime updatedAt
    }

    TOPPING {
        int id PK
        string name
        int price
    }

    ORDER {
        int id PK
        int userId FK
        string status
        int subtotal
        int discount
        string promoCode
        int total
        datetime createdAt
        datetime updatedAt
    }

    ORDER_ITEM {
        int id PK
        int orderId FK
        int productId FK
        int quantity
        int unitPrice
        string size
    }

    ORDER_ITEM_TOPPING {
        int orderItemId PK, FK
        int toppingId PK, FK
        int quantity
        int price
    }

    PAYMENT {
        int id PK
        int orderId FK
        int userId FK
        string method
        string status
        int amount
        string idempotencyKey
        string requestHash
        datetime createdAt
    }

    PROMOTION {
        int id PK
        string code UK
        string type
        int value
        int minOrder
        datetime expiresAt
        int usageCount
    }

    LOYALTY_TRANSACTION {
        int id PK
        int userId FK
        int orderId FK
        string type
        int points
        datetime createdAt
    }

    IDEMPOTENCY_RECORD {
        int id PK
        int userId FK
        string key
        string requestHash
        int orderId FK, UK
        datetime createdAt
    }
