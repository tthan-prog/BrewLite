@startuml deployment-diagram
title Deployment diagram - BrewLite (local, CI và production trên Render, xem ADR-006, ADR-007)
skinparam shadowing false

node "Thiết bị người dùng" <<device>> as DEV {
  artifact "Trình duyệt / PWA" as BROWSER
}

node "Internet" <<network>> as NET

node "CI/CD (GitHub Actions)" <<CI>> as CI {
  artifact "ci.yml\nLint, Unit Test, Build\n(mỗi pull request)" as A_CI
  artifact "cd.yml\nBuild image, Deploy, Smoke test\n(tag v* hoặc chạy tay)" as A_CD
  artifact "GitHub Secrets / Variables\n(Deploy Hook, URL production)" as A_SEC
}

node "GitHub Container Registry (GHCR)" <<registry>> as REG {
  artifact "brewlite-web:sha-<7 ký tự>\n(image)" as IMG_WEB
  artifact "brewlite-api:sha-<7 ký tự>\n(image)" as IMG_API
}

node "Render (production)" <<cloud platform>> as PROD {
  node "Web Service brewlite-web\nPORT 3000" <<execution environment>> as P_WEB {
    artifact "Next.js (container)" as A_WEB
  }
  node "Web Service brewlite-api\nPORT 3001" <<execution environment>> as P_API {
    artifact "NestJS (container)\nGET /health" as A_API
  }
  node "Render PostgreSQL\n(không public)" <<database server>> as P_DB {
    artifact "CSDL brewlite" as A_DB
    artifact "Ổ đĩa lưu trữ bền vững\n(persistent storage)" as A_DISK
  }
}

node "Máy lập trình viên" <<device>> as LOCAL {
  node "Docker Compose" <<execution environment>> as COMPOSE {
    artifact "web :3000" as L_WEB
    artifact "api :3001" as L_API
    artifact "db :5432\n(volume pgdata)" as L_DB
  }
}

BROWSER -- NET : <<HTTPS 443>>
NET -- P_WEB : <<HTTPS 443>>
NET -- P_API : <<HTTPS 443, REST/JSON>>
P_WEB -- P_API : <<HTTPS>>
P_API -- P_DB : <<TCP 5432, mạng nội bộ>>
A_DB -- A_DISK : <<lưu trữ>>

A_CD ..> IMG_WEB : <<push image>>
A_CD ..> IMG_API : <<push image>>
A_CD ..> P_WEB : <<Deploy Hook, HTTPS>>
A_CD ..> P_API : <<Deploy Hook, HTTPS>>
A_CD ..> P_API : <<Smoke test GET /health>>
IMG_WEB ..> P_WEB : <<deploy>>
IMG_API ..> P_API : <<deploy>>
A_SEC ..> A_CD : <<secret của CI>>

L_WEB -- L_API : <<HTTP>>
L_API -- L_DB : <<TCP 5432>>

note bottom of P_API
  Biến môi trường: DATABASE_URL, JWT_SECRET, FRONTEND_ORIGIN
  (cấu hình trên Render, không lưu trong repo).
  Log: xem trong Render Logs; health check: GET /health.
end note
note bottom of REG
  Package cần Public nếu Render kéo image không dùng credentials.
end note
note bottom of CI
  Ranh giới: Local (máy lập trình viên, Docker Compose),
  CI/CD (GitHub Actions, log nằm ở tab Actions),
  Production (Render).
end note
@enduml
