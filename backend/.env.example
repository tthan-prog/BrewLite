# Sao chép file này thành .env rồi sửa giá trị. KHÔNG đưa file .env lên Git.
PORT=3001
# Địa chỉ frontend được phép gọi API (CORS); nhiều địa chỉ cách nhau bằng dấu phẩy
FRONTEND_ORIGIN=http://localhost:3000

# Các biến dưới đây dùng từ Task 2 trở đi (CSDL, JWT) - chưa dùng trong khung dự án
DATABASE_URL=postgresql://brewlite:change_me@localhost:5432/brewlite
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d
